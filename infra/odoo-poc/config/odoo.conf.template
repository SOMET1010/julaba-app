; Gabarit de configuration Odoo 19 pour le POC JULABA.
; scripts/init.sh remplace les jetons __XXX__ et ecrit config/odoo.conf
; (fichier genere, ignore par git car il contient des secrets).
;
; Format impose : "cle = valeur" avec des espaces autour du "=".
; L'entrypoint de l'image odoo lit ces valeurs avec `cut -d " " -f3` ;
; un "cle=valeur" colle serait mal relu et les arguments --db_* injectes
; par l'entrypoint prendraient le pas.

[options]
admin_passwd = __ADMIN_PASSWD__

db_host = db
db_port = 5432
db_user = __DB_USER__
db_password = __DB_PASSWORD__

; Mono-base : le filtre epingle la base du POC, ce qui rend l'en-tete
; X-Odoo-Database inutile cote client JSON-2.
db_name = __DB_NAME__
dbfilter = ^__DB_NAME__$
list_db = False

addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

; Instance de test mono-utilisateur : un seul worker suffit et evite
; les surprises de cron concurrents pendant les essais d'API.
workers = 0
max_cron_threads = 1
proxy_mode = False
log_level = info
limit_time_cpu = 600
limit_time_real = 1200
