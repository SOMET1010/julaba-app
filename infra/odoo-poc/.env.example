# Copier en .env puis remplacer toutes les valeurs "change-me".
# .env est ignore par git : aucun secret ne doit etre commite.

# --- Base Odoo -------------------------------------------------------------
ODOO_DB=julaba_poc
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me-db
# Mot de passe maitre Odoo (creation/suppression de base via l'UI).
ODOO_MASTER_PASSWORD=change-me-master

# --- Exposition ------------------------------------------------------------
# 127.0.0.1 = accessible uniquement depuis la machine hote (recommande).
# Mettre 0.0.0.0 expose l'instance sur le reseau : a ne faire qu'en connaissance de cause.
ODOO_BIND_ADDR=127.0.0.1
ODOO_PORT=8069
# URL utilisee par les scripts de test (et plus tard par le backend JULABA).
ODOO_BASE_URL=http://127.0.0.1:8069

# --- Perimetre fonctionnel du POC ------------------------------------------
# Modules officiels uniquement. Les dependances (stock_account, product, ...)
# sont resolues automatiquement par Odoo.
# Ajouter sale_management si l'application Ventes doit apparaitre dans le menu.
ODOO_INSTALL_MODULES=point_of_sale,stock,sale,account
# true = donnees de demonstration Odoo chargees (catalogue de test pret a l'emploi).
ODOO_WITH_DEMO=true

# --- Utilisateur et cle API dedies -----------------------------------------
ODOO_API_USER_LOGIN=julaba_api
ODOO_API_USER_NAME=JULABA Integration (POC)
ODOO_API_USER_PASSWORD=change-me-api
ODOO_API_KEY_NAME=julaba-poc
ODOO_API_KEY_DAYS=90

# Rempli automatiquement par scripts/init.sh. Ne pas saisir a la main.
ODOO_API_KEY=

# Mono-base : laisser false. Passer a true seulement si plusieurs bases
# partagent le meme domaine (l'en-tete X-Odoo-Database est alors obligatoire).
ODOO_SEND_DB_HEADER=false
