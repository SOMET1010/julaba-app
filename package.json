{
  "name": "julaba-app",
  "version": "5.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "frontend_src",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev --workspace frontend_src\" \"npm run start:dev --workspace backend\"",
    "build": "npm run build --workspace frontend_src && npm run build --workspace backend",
    "install:all": "npm install",
    "check:nest-versions": "node scripts/check-nest-versions.mjs",
    "typecheck": "npm run typecheck --workspace frontend_src",
    "check": "node ci/check.mjs",
    "check:rapide": "node ci/check.mjs --rapide",
    "hooks:install": "git config core.hooksPath .githooks && echo \"hook pre-push actif\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mort": "knip",
    "duplication": "jscpd --config .jscpd.json"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jscpd": "^4.0.5",
    "knip": "^5.64.1",
    "typescript-eslint": "^8.45.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/testing": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.1.28",
    "@sentry/node": "10.69.0",
    "exceljs": "3.10.0",
    "jspdf": "4.2.1",
    "react-router": "7.18.4"
  },
  "overrides": {
    "typeorm": "^0.3.17",
    "multer": "^2.4.0",
    "lodash": "^4.18.0",
    "tmp": "^0.2.6",
    "ws": "^8.21.0",
    "glob": "^10.5.0",
    "minimatch": "^9.0.6",
    "js-yaml": "^5.1.2",
    "fast-csv": "^4.3.6",
    "qs": "^6.14.0",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "@sentry/node-cpu-profiler@2.4.4": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
