# ============================================================
# JULABA Backend — environnement PRODUCTION DOCKER (stack docker-compose.yml)
# ============================================================
# Ce modele est adapte a la BD DANS la stack Docker (service `postgres`,
# docker-compose.yml) : DB_HOST=postgres — le nom du service, PAS localhost,
# PAS host.docker.internal (ancien montage BD sur l'hote).
#
# Mise en route :
#   cp backend/.env.production.example backend/.env.production
#   # -> remplir les 3 secrets (fail-fast au boot sinon, voir verifierSecretsProduction)
#   docker compose up -d          # postgres + backend + frontend
#
# Secrets (openssl):
#   openssl rand -hex 32            # JWT_SECRET
#   openssl rand -hex 32            # REFRESH_TOKEN_SALT
#   openssl rand -hex 32            # PIN_ENCRYPTION_KEY
#
# Deploiement VPS (deploy.yml) : le fichier vit sur le serveur
# (/var/www/julaba/backend/.env.production) — gitignore, jamais commité.
# ============================================================

# ------------------------------------------------------------
# SERVEUR & RUNTIME (le conteneur ecoute sur 3000 — le compose mappe 3001:3000)
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://julaba.online
TRUST_PROXY=true                      # derriere le reverse proxy (nginx hote)
COOKIE_SAMESITE=none                  # prod: none + Secure (cookies cross-site)

# ------------------------------------------------------------
# BASE DE DONNÉES — le service postgres de docker-compose.yml
# ------------------------------------------------------------
DB_HOST=postgres                      # nom du service compose (reseau interne)
DB_PORT=5432
DB_USERNAME=julaba                    # = POSTGRES_USER du compose
DB_PASSWORD=julaba                    # = POSTGRES_PASSWORD du compose
DB_NAME=julaba_dev                    # = POSTGRES_DB du compose
DB_SSL=false                          # TLS inutile en interne compose
DB_LOGGING=false
# DB_SYNCHRONIZE / DB_MIGRATIONS_RUN : auto-geres au boot par
# prepareDatabase (base vierge -> schema construit ; base existante ->
# DB_MIGRATIONS_RUN respecte). Ne pas forcer ici.

# ------------------------------------------------------------
# AUTH — SECRETS OBLIGATOIRES EN PROD (fail-fast au boot, process.exit 1)
# ------------------------------------------------------------
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7
REFRESH_TOKEN_SALT=change-me-openssl-rand-hex-32
PIN_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
                                      # Ne JAMAIS tourner sans migration de rechiffrement

# ------------------------------------------------------------
# AUTH — WEBAUTHN (passkeys)
# ------------------------------------------------------------
WEBAUTHN_RP_ID=julaba.online
WEBAUTHN_ORIGIN=https://julaba.online

# ------------------------------------------------------------
# AUTH — BO / SEED DÉMO (false en prod)
# ------------------------------------------------------------
SEED_DEMO=false
SEED_DEMO_PASSWORD=1234
SEED_DEMO_BO_PASSWORD=
THROTTLE_DISABLED=false

# ------------------------------------------------------------
# INTÉGRATIONS / OBSERVABILITÉ (remplir si utilisées)
# ------------------------------------------------------------
BPAY_BASE_URL=
BPAY_EMAIL=
BPAY_PASSWORD=
BPAY_REFERENCE_CL=
BPAY_WEBHOOK_SECRET=

ANSUT_BASE_URL=
ANSUT_USERNAME=
ANSUT_PASSWORD=
ANSUT_SENDER_ID=
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
FEEDBAK_SMS_SUPPORT_NUMBER=

ONECI_API_KEY=
ONECI_SECRET_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

PIPER_BIN=/usr/local/bin/piper-tts    # volume monte par le compose
PIPER_VOICE=/var/www/julaba/piper-voices
VOICE_LOCAL_TTS=false

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@julaba.online

SENTRY_DSN=

ODOO_POC_ENABLED=false
ODOO_CLIENT_MODE=mock
ODOO_BASE_URL=
ODOO_API_KEY=
ODOO_DB=
ODOO_REAL_WRITE_ENABLED=false
ODOO_REAL_TIMEOUT_MS=8000
