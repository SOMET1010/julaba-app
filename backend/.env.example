# ============================================================
# JULABA Backend — Variables d'environnement
# ============================================================
# Ce fichier documente TOUTES les variables lues par le backend NestJS.
# Copier en `.env` et adapter les valeurs.
#
# ⚠️ En production : utiliser des secrets générés (Render `generateValue: true`)
#    pour JWT_SECRET, REFRESH_TOKEN_SALT, PIN_ENCRYPTION_KEY.
#    Le boot échoue (process.exit 1) si ces 3 secrets sont absents en prod
#    (verifierSecretsProduction() dans src/main.ts).
# ============================================================

# ------------------------------------------------------------
# SERVEUR & RUNTIME
# ------------------------------------------------------------
NODE_ENV=development                  # development | production | test
PORT=3000                             # Port d'écoute HTTP (Render injecte le sien)
API_PREFIX=api/v1                     # Préfixe global des routes
CORS_ORIGIN=http://localhost:5173     # Origine autorisée (séparateur virgule si multiple)
TRUST_PROXY=false                     # true en prod derrière Render (calibrer via /health/net)
COOKIE_SAMESITE=lax                   # lax | none | strict (prod: none + Secure)
RENDER_GIT_COMMIT=                    # Injecté par Render (SHA court pour /health)

# ------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL 16)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=julaba
DB_PASSWORD=julaba
DB_NAME=julaba_dev
DB_SSL=false                          # true en prod (Render PostgreSQL)
                                      # Sous Docker (docker-compose.yml) : DB_HOST=postgres
                                      # (nom du service) — modèle complet : .env.production.example
DB_SYNCHRONIZE=                       # Auto-set par prepareDatabase (true si base vierge)
DB_MIGRATIONS_RUN=                    # Auto-set par prepareDatabase
                                      # ⚠️ En prod : false (workaround incident 18/09/2026, voir ADR-0002)
DB_LOGGING=false                      # true pour debug SQL

# ------------------------------------------------------------
# AUTH — SECRETS OBLIGATOIRES EN PROD (fail-fast au boot)
# ------------------------------------------------------------
JWT_SECRET=change-me-32-bytes-hex     # Signature JWT (servira aussi de legacyKey PIN V1)
JWT_EXPIRES_IN=15m                    # Durée de vie access token
JWT_REFRESH_DAYS=7                    # Durée de vie refresh token (jours)
REFRESH_TOKEN_SALT=change-me-salt     # HMAC-SHA256 pour hash refresh tokens (au moins 32 octets)
PIN_ENCRYPTION_KEY=change-me-32-bytes-hex  # AES-256-GCM (32 octets hex recommandés, sinon dérivée SHA-256)
                                          # ⚠️ Ne JAMAIS tourner sans migration de rechiffrement
# AUTH_TELEPHONES_TEST — NON écrit ici volontairement : les numéros de recette
#   vivent dans le MIROIR (TEST_PHONES côté écran / TELEPHONES_TEST_CODE côté
#   backend) et ne sont pas recopiés dans un fichier du dépôt. Un .env LOCAL
#   qui existe doit porter la liste alignée sur ce miroir, sinon le serveur
#   journalise un numéro que l'écran accepte (ou l'inverse) — garde
#   `test:enum-check-phone`, qui le vérifie.

# ------------------------------------------------------------
# AUTH — WEBAUTHN (passkeys)
# ------------------------------------------------------------
WEBAUTHN_RP_ID=julaba.online          # WebAuthn Relying Party ID
WEBAUTHN_ORIGIN=https://julaba.online # WebAuthn expected origin

# ------------------------------------------------------------
# AUTH — BO / SEED DÉMO
# ------------------------------------------------------------
SEED_DEMO=false                       # false en prod, true force seed démo (dev seulement)
SEED_DEMO_PASSWORD=1234               # Mot de passe comptes acteur démo (valeur publiée assumée)
SEED_DEMO_BO_PASSWORD=                # ⚠️ Obligatoire si seed démo BO. Refuse '123456' (ancienne valeur publiée).
THROTTLE_DISABLED=false               # true pour désactiver throttling (recette/e2e uniquement)

# ------------------------------------------------------------
# CAISSE — CRÉDIT CLIENT (gel SERVEUR — C-04 / MARCHAND-01)
# ------------------------------------------------------------
# Le crédit client est gelé pour le pilote espèces. Ce flag en est la
# protection SERVEUR (audit MARCHAND-01 du 19/10/2026 : le gel n'était qu'une
# constante UI) : tant qu'il vaut false, POST /caisse/credits,
# PATCH /caisse/credits/:id/acompte et PATCH /caisse/credits/:id/payer
# répondent 403 « Crédit client désactivé côté serveur (pilote espèces) ».
# Ne passer à true qu'APRÈS verdissement des invariants I4/I6
# (backend/test/invariants/blockers.spec.ts) et recette du crédit.
CAISSE_CREDIT_SERVEUR_ACTIF=false     # false = crédit désactivé (403) côté serveur
                                      # Harnais d'invariants (NODE_ENV=test) : exerçable
                                      # par défaut pour prouver I4/I5/I6 ; fermons-le
                                      # explicitement là avec la valeur 'false'.

# ------------------------------------------------------------
# B-PAY (intégration paiement mobile)
# ------------------------------------------------------------
BPAY_BASE_URL=
BPAY_EMAIL=
BPAY_PASSWORD=
BPAY_REFERENCE_CL=
#
# Webhooks B-Pay — C-07 (audit comptable 12/10 §4 chaîne B et §6 ; résidu
# confirmé AUDIT-ACTEUR-MARCHAND-2026-10-19 §4) + SEC-022 (.ai/SEC_BUGS.md).
# Voir src/bpay/bpay-webhook.securite.ts (la porte) et main.ts (capture du
# corps brut via body-parser `verify`).
#
BPAY_WEBHOOK_SECRET=                  # Clé HMAC-SHA256 du corps BRUT des webhooks (/bpay/callback et /wallets/public/pay-callback).
                                      # Lecture utf8 par défaut ; une valeur de 64 hexadécimales est AUSSI essayée comme clé brute de 32 octets.
                                      # Défini  → HMAC OBLIGATOIRE (en-tête x-bpay-signature, hex, préfixe sha256= accepté).
                                      # Absent  → /bpay/callback refuse tout callback (fail-closed, comme avant ce chantier) ;
                                      #           /wallets/public/pay-callback traite SANS vérification (état antérieur, recette QR) — WARN au boot de chaque callback.
BPAY_WEBHOOK_LEGACY=true              # true (DÉFAUT CE RUN, compat VPS julaba-dev.ansut.ci) : l'ancien header secret x-bpay-secret est
                                      # encore accepté quand la signature HMAC est absente — chaque acceptation journalise un WARN
                                      # « webhook legacy accepté — configurez BPAY_WEBHOOK_SECRET ». Mettre false dès que B-Pay signe en HMAC.
BPAY_WEBHOOK_IPS=                     # Allowlist IP (CSV, ex. 10.0.0.7,51.75.1.2) des webhooks B-Pay ; vide = filtre désactivé.
                                      # Compare req.ip (Express) : derrière reverse proxy, calibrer TRUST_PROXY (cf. /health/net) sans quoi
                                      # toutes les callbacks partagent l'IP du proxy et seraient refusées.

# ------------------------------------------------------------
# ANSUT / SMS (envoi OTP, notifications)
# ------------------------------------------------------------
ANSUT_BASE_URL=
ANSUT_USERNAME=
ANSUT_PASSWORD=
ANSUT_SENDER_ID=
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
FEEDBAK_SMS_SUPPORT_NUMBER=

# ------------------------------------------------------------
# ONECI (vérification NNI)
# ------------------------------------------------------------
ONECI_API_KEY=
ONECI_SECRET_KEY=

# ------------------------------------------------------------
# VOIX — CLOUD (Tata Nanti Lou)
# ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ------------------------------------------------------------
# VOIX — LLM (OpenAI ou compatible)
# ------------------------------------------------------------
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ------------------------------------------------------------
# VOIX — OFFLINE (Piper TTS local, défensif)
# ------------------------------------------------------------
PIPER_BIN=                            # Chemin binaire piper (installé par scripts/setup-piper.sh)
PIPER_VOICE=                          # Chemin modèle voix piper
VOICE_LOCAL_TTS=false                 # true pour forcer TTS local

# ------------------------------------------------------------
# WEB PUSH (VAPID)
# ------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@julaba.online

# ------------------------------------------------------------
# SENTRY (observabilité — optionnel)
# ------------------------------------------------------------
SENTRY_DSN=                           # Laisser vide pour désactiver

# ------------------------------------------------------------
# ODOO GATEWAY (POC — désactivé par défaut)
# ------------------------------------------------------------
ODOO_POC_ENABLED=false                # Feature flag (false = 404 sur /odoo-poc/*)
ODOO_CLIENT_MODE=mock                 # mock | real (real exige ODOO_BASE_URL + ODOO_API_KEY)
ODOO_BASE_URL=
ODOO_API_KEY=
ODOO_DB=
ODOO_REAL_WRITE_ENABLED=false         # Allow-list lecture seule (false défaut)
ODOO_REAL_TIMEOUT_MS=8000             # Timeout client Odoo real
