# ── Général ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# ── Base de données ───────────────────────────────────────
DB_HOST=rec-julaba-db-02.postgres.database.azure.com
DB_PORT=5432
DB_USERNAME=adm_dtdijulaba
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

# ── Auth / JWT ────────────────────────────────────────────
JWT_SECRET=change-me-in-production
REFRESH_TOKEN_SALT=change-me-in-production
PIN_ENCRYPTION_KEY=change-me-32-characters-long!

# ── WebAuthn ──────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Cookie ────────────────────────────────────────────────
COOKIE_SAMESITE=lax

# ── Voix / TTS ───────────────────────────────────────────
TTS_ENABLE_CLOUD=false

# ── Push Notifications (VAPID) ────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@julaba.online

# ── SMS Feedbak ───────────────────────────────────────────
FEEDBAK_SMS_SUPPORT_NUMBER=+225 00 00 00 00

# ── Seed démo ─────────────────────────────────────────────
SEED_DEMO=true

# ── Sentry (optionnel) ───────────────────────────────────
SENTRY_DSN=
